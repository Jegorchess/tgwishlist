# Copy to .env (backend/.env for local runs without Docker). Never commit .env!

# Token from @BotFather
BOT_TOKEN=
# Public HTTPS URL of the Mini App (tunnel URL locally, your domain on the VPS)
WEBAPP_URL=https://wishlist.example.com
# Lifetime of Telegram initData in seconds
INIT_DATA_MAX_AGE=86400
# Allow "Authorization: dev" for local browser development. Keep false in production!
DEV_AUTH=false

# Where uploaded wish photos are stored (Docker sets /data/media)
MEDIA_DIR=media

# Your Telegram ID(s), comma-separated: permanent access + managing the invite link.
# Find it in the users table or via @userinfobot.
ADMIN_TELEGRAM_IDS=
# Bot username for invite links, e.g. my_wishlist_bot (recommended on the server;
# looked up via Telegram automatically when empty)
BOT_USERNAME=

# Docker Compose / VPS
POSTGRES_PASSWORD=change-me
SITE_ADDRESS=:80
