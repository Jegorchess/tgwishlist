# Copy to .env (backend/.env for local runs without Docker). Never commit .env!

# Token from @BotFather
BOT_TOKEN=
# Public HTTPS URL of the Mini App (tunnel URL locally, your domain on the VPS)
WEBAPP_URL=https://wishlist.example.com
# Lifetime of Telegram initData in seconds
INIT_DATA_MAX_AGE=86400
# Allow "Authorization: dev" for local browser development. Keep false in production!
DEV_AUTH=false

# Docker Compose / VPS
POSTGRES_PASSWORD=change-me
SITE_ADDRESS=:80
